# Copia este archivo a .env y ajusta el valor. El .env no se versiona.

# URL del backend (API Node/Express, carpeta backend/).
# Debe coincidir con el PORT del backend. Si se omite, el frontend usa http://127.0.0.1:8000
# Ojo: esta URL se fija al compilar (npm run build); para otro entorno hay que recompilar.
VITE_API_URL=http://127.0.0.1:8000
