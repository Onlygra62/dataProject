# Copia este archivo a .env y ajusta los valores. El .env no se versiona.

# Puerto donde escucha la API
PORT=8000

# Tamano maximo de un archivo subido, en megabytes
MAX_UPLOAD_MB=50

# Origenes del front que pueden llamar a la API (CORS), separados por comas.
# En produccion pon aqui la URL donde se publica el front.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Peticiones maximas por minuto desde una misma IP
RATE_LIMIT_MAX=100
